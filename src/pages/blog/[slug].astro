---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteConfig from '../../data/site.config.json';
import cities from '../../data/cities.json';
import intents from '../../data/intents.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as any;
const { Content } = await render(post);
const primaryIntentSlug = intents[0]?.slug ?? 'fascia-soffit';

const relatedCityMeta = (post.data.relatedCities as string[])
  .map((slug) => cities.find((c: any) => c.slug === slug))
  .filter(Boolean);

const faqSchema = post.data.faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: post.data.faqs.map((f: { question: string; answer: string }) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;

const updated = post.data.updatedDate ?? post.data.publishedDate;
const updatedLabel = new Date(updated).toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
---

<BaseLayout title={`${post.data.metaTitle} | ${siteConfig.siteName}`} description={post.data.metaDescription}>
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <div class="container article-page" style="padding-top: 1.5rem;">
    <nav class="breadcrumb"><a href="/">Home</a> <span>&rsaquo;</span> <a href="/blog/">Guides &amp; Advice</a> <span>&rsaquo;</span> <span>{post.data.title}</span></nav>

    <article class="article-body">
      <h1>{post.data.title}</h1>
      <p class="article-meta">Updated {updatedLabel}{post.data.readingMinutes ? ` · ${post.data.readingMinutes} min read` : ''}</p>

      <Content />

      {post.data.faqs.length > 0 && (
        <section class="section" style="padding-bottom: 0;">
          <div class="section-title"><h2>Frequently asked questions</h2></div>
          <div class="faq-list">
            {post.data.faqs.map((f: { question: string; answer: string }) => (
              <details class="faq-item">
                <summary>{f.question}</summary>
                <p>{f.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      {relatedCityMeta.length > 0 && (
        <section class="section" style="padding-bottom: 0;">
          <div class="section-title"><h2>Compare quotes in these areas</h2></div>
          <ul class="pill-list">
            {relatedCityMeta.map((c: any) => (
              <li><a class="pill" href={`/${primaryIntentSlug}-${c.slug}/`}>{c.name}</a></li>
            ))}
          </ul>
        </section>
      )}

      <div class="article-cta">
        <h3>Get up to 3 free roofline quotes</h3>
        <p>Compare vetted local installers &mdash; free, no obligation.</p>
        <a class="btn btn-accent" href="/quote">Get my free quote &rarr;</a>
      </div>
    </article>
  </div>
</BaseLayout>
