---
import '../styles/global.css';
import siteConfig from '../data/site.config.json';
import cities from '../data/cities.json';
import intents from '../data/intents.json';
import { ICONS, getInitials } from '../lib/logoIcon';

interface Props {
  title: string;
  description: string;
  indexable?: boolean;
  canonicalPath?: string;
  ogImage?: string;
}

const { title, description, indexable = true, canonicalPath = Astro.url.pathname, ogImage } = Astro.props;
const siteOrigin = `https://${siteConfig.domain}`;
const canonicalUrl = new URL(canonicalPath, siteOrigin).toString();
const socialImage = ogImage
  ? new URL(ogImage, siteOrigin).toString()
  : `${siteOrigin}/og-default.png`;
const telHref = `tel:${siteConfig.phone.replace(/\s+/g, '')}`;
const initials = getInitials(siteConfig.siteName);
const iconPaths = (siteConfig as any).logoIcon && ICONS[(siteConfig as any).logoIcon];

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: siteConfig.siteName,
  ...(siteConfig.phoneEnabled !== false && { telephone: siteConfig.phone }),
  email: siteConfig.email,
  ...(siteConfig.legalAddress && { address: { '@type': 'PostalAddress', streetAddress: siteConfig.legalAddress } }),
  url: siteOrigin,
  ...(siteConfig.aggregateRating && {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: siteConfig.aggregateRating.value,
      reviewCount: siteConfig.aggregateRating.count,
    },
  }),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.siteName,
  url: siteOrigin,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteOrigin}/areas?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const clarityId = (siteConfig as any).clarityId ?? '';
const matomoUrl = (siteConfig as any).matomoUrl ?? '';
const matomoSiteId = (siteConfig as any).matomoSiteId ?? '';

const popularCitySlugs = ['london', 'manchester', 'birmingham', 'leeds', 'bristol', 'glasgow'];
const popularCities = popularCitySlugs
  .map((slug) => cities.find((c) => c.slug === slug))
  .filter(Boolean);
const primaryIntentSlug = intents[0]?.slug ?? 'casement-windows';
---

<!doctype html>
<html lang="en" style={`--color-primary: ${siteConfig.themeColor}; --color-accent: ${siteConfig.accentColor}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexable && <link rel="canonical" href={canonicalUrl} />}
    <meta name="robots" content={indexable ? 'index,follow' : 'noindex,follow'} />
    <meta name="theme-color" content={siteConfig.themeColor} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content={siteConfig.locale?.replace('-', '_') ?? 'en_GB'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    {clarityId && (
      <script is:inline set:html={`(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window, document, "clarity", "script", "${clarityId}");`} />
    )}

    {matomoUrl && matomoSiteId && (
      <script is:inline set:html={`var _paq = window._paq = window._paq || [];_paq.push(['enableHeartBeatTimer', 15]);_paq.push(['trackPageView']);_paq.push(['enableLinkTracking']);(function() {var u="${matomoUrl}";_paq.push(['setTrackerUrl', u+'matomo.php']);_paq.push(['setSiteId', '${matomoSiteId}']);var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);})();`} />
    )}
    {matomoUrl && matomoSiteId && (
      <script is:inline>
        /* Mesure des leads : relaie vers Matomo les étapes que le widget leads.work pousse dans
           window.dataLayer (form_view, quote_start, category_select, widget_event, quote_submit,
           quote_submit_error) + les clics tel:/mailto:. Objectif Matomo « Lead » = événement
           d'action "Lead submitted". Doit s'exécuter AVANT le chargement du widget (d'où le <head>). */
        (function () {
          window._paq = window._paq || [];
          // Toujours passer par window._paq : matomo.js remplace le tableau par son propre objet au chargement.
          function track(c, a, n) { window._paq.push(['trackEvent', c, a, n]); }
          var dl = (window.dataLayer = window.dataLayer || []);
          var names = { form_view: 'Form view', quote_start: 'Quote started', category_select: 'Category selected', quote_submit_error: 'Submit error' };
          function context() {
            var q = new URLSearchParams(location.search);
            var parts = [q.get('intent'), q.get('city')].filter(Boolean);
            return parts.length ? parts.join(' / ') : location.pathname;
          }
          function handle(e) {
            if (!e || typeof e !== 'object' || !e.event) return;
            var label = context();
            if (e.event === 'quote_submit') {
              track('Lead form', e.lead_outcome === 'duplicate' ? 'Lead duplicate' : 'Lead submitted', label);
            } else if (e.event === 'widget_event') {
              track('Lead form step', String(e.widget_action || e.widget_category || 'step'), label);
            } else if (names[e.event]) {
              if (e.event === 'quote_submit_error' && e.error_fields) label += ' | ' + e.error_fields;
              track('Lead form', names[e.event], label);
            }
          }
          for (var i = 0; i < dl.length; i++) handle(dl[i]);
          var push = dl.push;
          dl.push = function () {
            for (var j = 0; j < arguments.length; j++) { try { handle(arguments[j]); } catch (err) {} }
            return push.apply(dl, arguments);
          };
          document.addEventListener('click', function (ev) {
            var a = ev.target && ev.target.closest ? ev.target.closest('a[href^="tel:"], a[href^="mailto:"]') : null;
            if (a) track('Contact', a.getAttribute('href').indexOf('tel:') === 0 ? 'Phone click' : 'Email click', location.pathname);
          }, true);
        })();
      </script>
    )}

    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="/">
        <span class="logo-badge" aria-hidden="true">
          {iconPaths ? (
            <svg viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths} />
          ) : initials}
        </span>
        {siteConfig.siteName}
      </a>

      <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="primary-nav">
        <span></span><span></span><span></span>
      </button>

      <nav id="primary-nav" class="primary-nav" aria-label="Primary">
        <ul>
          {intents.map((i) => (
            <li><a href={`/services/${i.slug}/`}>{i.shortLabel ?? i.label}</a></li>
          ))}
          <li><a href="/areas">Areas</a></li>
          <li><a href="/blog/">Guides</a></li>
        </ul>
      </nav>

      <div class="header-actions">
        {siteConfig.phoneEnabled !== false ? (
          <Fragment>
            <a class="phone-link" href={telHref}>{siteConfig.phone}</a>
            <a class="btn btn-accent" href={telHref}>Call now</a>
          </Fragment>
        ) : (
          <a class="btn btn-accent" href="/quote">Get a free quote</a>
        )}
      </div>
    </header>

    <script is:inline>
      (function () {
        var btn = document.querySelector('.nav-toggle');
        var nav = document.getElementById('primary-nav');
        if (!btn || !nav) return;
        btn.addEventListener('click', function () {
          var open = nav.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        });
      })();
    </script>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-grid">
        <div class="footer-col">
          <h4>{siteConfig.siteName}</h4>
          {siteConfig.disclosureText && <p class="footer-disclosure">{siteConfig.disclosureText}</p>}
        </div>
        <div class="footer-col">
          <h4>Popular locations</h4>
          <ul class="footer-links">
            {popularCities.map((c: any) => (
              <li><a href={`/${primaryIntentSlug}-${c.slug}/`}>{c.name}</a></li>
            ))}
            <li><a href="/areas">View all areas</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Services</h4>
          <ul class="footer-links">
            {intents.map((i) => (
              <li><a href={`/services/${i.slug}/`}>{i.shortLabel ?? i.label}</a></li>
            ))}
          </ul>
        </div>
        <div class="footer-col">
          <h4>Company</h4>
          <ul class="footer-links">
            <li><a href="/areas">All areas &amp; services</a></li>
            <li><a href="/blog/">Guides &amp; advice</a></li>
            <li><a href="/quote">Get a quote</a></li>
            <li><a href="/mentions-legales">Legal notice</a></li>
            <li><a href="/politique-de-confidentialite">Privacy policy</a></li>
          </ul>
        </div>
      </div>
      <p class="footer-legal">{siteConfig.legalName}{siteConfig.legalAddress && <Fragment> &middot; {siteConfig.legalAddress}</Fragment>}</p>
    </footer>
  </body>
</html>
